<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="standard">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="variant" default="v1" />

    <!-- Import standard urdf file -->
    <xacro:include filename="$(find standrad_description)/urdf/standard_$(arg variant).urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="standard.ros2_control.xacro" />


    <xacro:standard_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
